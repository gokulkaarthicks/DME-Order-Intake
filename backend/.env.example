# Application
APP_NAME=DME Order Intake
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# PostgreSQL (matches docker-compose.yml defaults; host port 5434)
DATABASE_URL=postgresql+psycopg://dme:dme@127.0.0.1:5434/dme_order_intake
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

